# Your GitJournal repository (https; or ssh with a key mounted at ~/.ssh).
REPO_URL=https://github.com/you/journal.git
# A token with read access to it (a fine-grained GitHub token with
# Contents: Read-only is enough; GitLab: set GIT_USERNAME=oauth2).
GIT_TOKEN=
# Required unless the port is only reachable by you. Any user name works.
DASHBOARD_PASSWORD=
# Folder inside the repo that InkDeck's notes folder mirrors (usually empty).
NOTES_SUBFOLDER=
# Seconds between fetches.
PULL_INTERVAL=300
