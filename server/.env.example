# Your GitJournal repository (https; or ssh with a key mounted at ~/.ssh).
REPO_URL=https://github.com/you/journal.git
# A token with read access to it (a fine-grained GitHub token with
# Contents: Read-only is enough; GitLab: set GIT_USERNAME=oauth2).
GIT_TOKEN=
# Required unless the port is only reachable by you. Any user name works.
DASHBOARD_PASSWORD=
# Folder inside the repo that InkDeck's notes folder mirrors (usually empty).
NOTES_SUBFOLDER=
# Seconds between fetches.
PULL_INTERVAL=300
# Your time zone, for what counts as "today" (IANA name).
TZ=America/Los_Angeles

# --- Companion: pet, levels, achievements, weather -------------------------
# 1 = commit _inkdeck/companion.md (the X4 shows it) and weather in finished
# entries back to the repo. Needs GIT_TOKEN with write access
# (GitHub fine-grained token: Contents: Read and write).
WRITE_BACK=0
# Branch to follow and push to (default: the repo's default branch).
BRANCH=
# Weather, sun and air quality from Open-Meteo (free, no key): on/off.
WEATHER=on
# "lat,lon" used for sessions without a phone location.
HOME_LOCATION=
DAILY_GOAL=250
# Missed days per week that don't break a streak.
REST_DAYS=1
PET_NAME=Inkling
# gentle: a neglected pet hibernates until you write again. classic: it's lost.
PET_MODE=gentle
